CC = arm-linux-gnueabihf-gcc
CFLAGS = -O2 -mcpu=cortex-a7 -mfpu=neon -mfloat-abi=hard -marm -U_TIME_BITS -D_TIME_BITS=32 -U_FORTIFY_SOURCE -fno-stack-protector -fno-pie -fcommon -w
CXX = arm-linux-gnueabihf-g++
CXXFLAGS =  -mfpu=neon -marm -mfloat-abi=hard -mfpu=neon -marm -mfloat-abi=hard
WINDRES = 
MOC = 
ASFLAGS =  -mfpu=neon -mfloat-abi=hard -mfpu=neon -mfloat-abi=hard
LDFLAGS = -L@SYSROOT@/lib -no-pie -static-libgcc @BUILD@/glibc226_shim.o -Wl,-rpath-link=@ROOTFS@/lib:@ROOTFS@/usr/lib:@ROOTFS@/usr/lib/pulseaudio -Wl,--dynamic-linker=/lib/ld-linux-armhf.so.3
INCLUDE_DIRS = -I./deps/7zip
LIBRARY_DIRS = 
PACKAGE_NAME = retroarch
BUILD = 
PREFIX = /usr
HAVE_7ZIP = 1
HAVE_AL = 0
ifneq ($(C89_BUILD),1)
HAVE_ALSA = 1
endif
ALSA_CFLAGS = -I@SYSROOT@/inc
ALSA_LIBS = -L@SYSROOT@/lib -lasound
